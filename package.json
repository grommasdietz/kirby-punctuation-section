{
  "name": "kirby-punctuation-section",
  "type": "module",
  "version": "3.1.1",
  "private": true,
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "pnpm": ">=12 <13",
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "kirbyup dev src/panel/index.js",
    "build": "kirbyup src/panel/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\"",
    "build:check": "node tools/check-generated-assets.mjs index.js index.css",
    "test:browser": "node tests/browser.mjs",
    "test:archive": "node tools/verify-release-archive.mjs",
    "verify": "composer validate --strict --no-check-version && composer verify && pnpm lint && pnpm build:check && pnpm test:archive && pnpm test:browser"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.0",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.21",
    "bumpp": "^10.2.2",
    "eslint": "^9.33.0",
    "kirbyup": "^4.0.0-beta.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "zx": "^8.8.0"
  }
}
