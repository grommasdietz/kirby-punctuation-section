{
  "name": "johannschopplich/kirby-punctuation-section",
  "description": "Insert punctuation marks into your text with a single click",
  "type": "kirby-plugin",
  "version": "3.1.1",
  "keywords": [
    "clipboard",
    "kirby",
    "punctuation",
    "typography"
  ],
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/kirby-punctuation-section#readme",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "getkirby/composer-installer": "^1.2",
    "php": "^8.3"
  },
  "require-dev": {
    "getkirby/cms": "^6.0@beta",
    "friendsofphp/php-cs-fixer": "^3.93"
  },
  "scripts": {
    "csfix": "@lint:fix",
    "dist": "composer install --no-dev --optimize-autoloader",
    "lint": "php-cs-fixer fix --dry-run --diff --sequential",
    "lint:fix": "php-cs-fixer fix --sequential",
    "test": "@php tests/field.php",
    "verify": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "platform": {
      "php": "8.3.16"
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^6.0"
    }
  },
  "autoload": {
    "psr-4": {
      "JohannSchopplich\\Punctuation\\": "src/fields/"
    }
  },
  "conflict": {
    "getkirby/cms": "<6.0 || >=7.0"
  }
}
